{
  "name": "yappply",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c teal,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch-path=./server server/index.mjs",
    "dev:web": "next dev --port 5173",
    "build": "next build",
    "lint": "oxlint",
    "start": "concurrently -k -n server,web -c teal,cyan \"node server/index.mjs\" \"next start --port 5173\"",
    "predev": "node -e \"console.log('\\n  Yappply → http://localhost:5173\\n')\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3"
  }
}
